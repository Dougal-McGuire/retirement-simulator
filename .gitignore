# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.playwright-mcp
.improvement-loop/

**/err/*
tmp/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Alternate dist dirs (NEXT_DIST_DIR) used when several dev servers share this
# checkout. They must stay ignored: Tailwind's source detection scans anything
# that is not gitignored, and the binary Turbopack caches inside these folders
# produce corrupted utility class candidates.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the secret-free template
!.env.example

# MCP configuration with sensitive keys
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build info (generated at build time)
src/lib/build-info/build-info.json
