# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Every variable below is OPTIONAL: with none of them set the app builds, runs
# and tests exactly as before, and the Google sign-in control renders disabled.

# ---------------------------------------------------------------------------
# Google Authentication (Auth.js / next-auth v5)
# ---------------------------------------------------------------------------

# Random 32-byte secret used to sign the session JWT.
# Generate with:  openssl rand -base64 32     (or: npx auth secret)
AUTH_SECRET=

# OAuth 2.0 Client ID / secret from Google Cloud Console
# (APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel only — see README "Google Authentication".
# Required for preview deployments, where the hostname is not the canonical one.
# AUTH_TRUST_HOST=true
# Optional explicit callback base URL; normally inferred from the request host.
# AUTH_URL=https://your-app.vercel.app/api/auth

# ---------------------------------------------------------------------------
# Account sync storage (Upstash Redis over REST)
# ---------------------------------------------------------------------------
# Only needed if plans should follow a Google account across devices. Without
# these two the app behaves exactly as it does today: plans stay in a per-account
# localStorage namespace on the device, and /api/plans answers "not configured".
#
# Easiest source: Vercel dashboard -> Storage -> Create Database -> Upstash
# (Redis). Connecting it to the project injects both variables automatically.
# See README "Google-Konto-Sync einrichten", block C.
#
# Server-only: neither value is ever sent to the browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash's own names for the same pair are accepted as aliases:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
